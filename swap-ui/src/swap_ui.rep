// Qt Remote Objects interface for the Basecamp swap UI backend.
//
// QML binds to this surface only. The C++ swap_ui backend owns UI state and
// calls the process-isolated `swap` core module for actual swap operations.

class SwapUi
{
    // Session/status state
    PROP(QString status READWRITE)
    PROP(QString errorMessage READWRITE)
    PROP(QString swapRole READWRITE)
    PROP(bool running READWRITE)
    PROP(QString lastResultJson READWRITE)
    PROP(QString validationErrorsJson READWRITE)

    // Explicit config state. These fields are serialized into the JSON passed
    // to swap.fetchBalances/runMaker/runTaker/refund*/publishOffer.
    PROP(QString ethRpcUrl READWRITE)
    PROP(QString ethPrivateKey READWRITE)
    PROP(QString ethHtlcAddress READWRITE)
    // Canonical, PINNED swap venue (defense-in-depth for the offer board). These
    // are the app's built-in values — the ETH HTLC contract (defaultEthHtlcAddress)
    // and the LEZ HTLC program (defaultLezHtlcProgramId) — NOT the user-editable
    // config fields above. The offer board ghosts (renders a disabled
    // "blocked — unsafe" row for) any offer whose eth_htlc_address /
    // lez_htlc_program_id differs from these, mirroring the accept-time venue
    // check. Set once at startup (ETH synchronously; LEZ via the async default
    // fill) and never overwritten by an offer. Empty until resolved, which the
    // board treats as "not yet known" (no ghosting) rather than a mismatch.
    PROP(QString canonicalEthHtlcAddress READWRITE)
    PROP(QString canonicalLezHtlcProgramId READWRITE)
    PROP(QString lezSequencerUrl READWRITE)
    PROP(QString lezSigningKey READWRITE)
    PROP(QString lezWalletHome READWRITE)
    PROP(QString lezAccountId READWRITE)
    PROP(QString lezHtlcProgramId READWRITE)
    PROP(QString lezAmount READWRITE)
    PROP(QString ethAmount READWRITE)
    PROP(QString lezTimelockMinutes READWRITE)
    PROP(QString ethTimelockMinutes READWRITE)
    PROP(QString ethRecipientAddress READWRITE)
    PROP(QString lezTakerAccountId READWRITE)
    PROP(QString pollIntervalMs READWRITE)

    // Balances
    PROP(QString ethAddress READWRITE)
    PROP(QString ethBalance READWRITE)
    PROP(QString lezAccount READWRITE)
    PROP(QString lezBalance READWRITE)
    // Per-side balance-read failures (issue #169). Every fetchBalances() caller
    // is an automatic refresh, so a failed read is published HERE — per chain,
    // for the Setup step and the account strip that own that chain — instead of
    // into `errorMessage`, which put a global red banner over a first-run app
    // for a background poll the user never triggered. Empty unless that side
    // has failed repeatedly; the policy (swap-ui/src/balance_error_policy.h)
    // stays quiet through a single blip and clears on the first good read.
    PROP(QString ethBalanceError READWRITE)
    PROP(QString lezBalanceError READWRITE)

    // Maker state
    PROP(bool makerRunning READWRITE)
    PROP(QString makerJobId READWRITE)
    PROP(QString makerCurrentStep READWRITE)
    PROP(QStringList makerProgressSteps READWRITE)
    PROP(QString makerResultJson READWRITE)

    // Taker state
    PROP(bool takerRunning READWRITE)
    PROP(QString takerJobId READWRITE)
    PROP(QString takerCurrentStep READWRITE)
    PROP(QStringList takerProgressSteps READWRITE)
    PROP(QString takerResultJson READWRITE)
    // Live ETH-lock proof, surfaced mid-swap (not only at completion). Set at
    // the taker's EthLocked progress step from the same tx_hash/chain_id the
    // receipt reads at the end, so the in-progress stepper can show a
    // copyable lock-tx line (and Sepolia explorer link) while the maker's LEZ
    // lock is still pending — a user can verify their own ETH is on-chain
    // rather than wonder if the swap is stuck. Cleared at the start of each
    // taker run. Additive-only surface (see receiptsJson note above).
    PROP(QString takerEthLockTx READWRITE)
    PROP(int takerEthChainId READWRITE)

    // Maker auto-accept state
    PROP(bool autoAcceptRunning READWRITE)
    PROP(QString autoAcceptJobId READWRITE)
    PROP(int autoAcceptCompleted READWRITE)
    PROP(int autoAcceptFailed READWRITE)
    PROP(int autoAcceptIteration READWRITE)
    PROP(QStringList swapHistory READWRITE)

    // Messaging/offers
    PROP(bool messagingConnected READWRITE)
    PROP(int messagingPeerCount READWRITE)
    // Whether messagingPeerCount is a live fleet reading (as opposed to the
    // 0 placeholder before the first probe / when the installed
    // delivery_module can't answer its node-info API). A KNOWN zero while
    // connected means fleet isolation — offers cannot arrive.
    PROP(bool messagingPeerCountKnown READWRITE)
    PROP(QString messagingConnectionStatus READWRITE)
    // Actionable delivery-health hint from the swap module (fleet isolation /
    // out-of-date delivery_module); empty when healthy.
    PROP(QString messagingHint READWRITE)
    PROP(bool messagingRetrying READWRITE)
    PROP(QString offersJson READWRITE)
    PROP(QString offerResultJson READWRITE)
    PROP(bool balancesLoading READWRITE)
    PROP(bool messagingLoading READWRITE)
    PROP(bool offersLoading READWRITE)
    PROP(bool publishingLoading READWRITE)
    PROP(bool refundsLoading READWRITE)

    // Per-swap coordination over Delivery (M2). The active hashlock is set
    // once the side learns it (taker: from PreimageGenerated; maker: from
    // EthLockDetected). coordinationEventsJson surfaces SwapAccept-shaped
    // payloads received on /atomic-swaps/1/swap-<hashlock>/json.
    PROP(QString coordinationActiveHashlock READWRITE)
    PROP(QString coordinationEventsJson READWRITE)
    PROP(QString coordinationLastResultJson READWRITE)

    // Durable swap-history journal (receipt cards, PR2). receiptsJson is a
    // JSON array of swap-receipt/1 objects, newest first, capped at 200 —
    // loaded from the per-profile JSONL journal at init and prepended on
    // every completed/refunded/failed swap. Additive-only surface: the rep
    // source and its QML consumer ship in the same module package and the
    // Basecamp host acquires the replica dynamically, so extending this
    // block never breaks a deployed peer.
    PROP(QString receiptsJson READWRITE)

    // Guided first-run Setup state (see SetupView.qml). Replaces hand-typing
    // two private keys + two long account IDs with buttons: generate-or-
    // import an ETH key, create a LEZ account, then fund it (initialize +
    // pinata-claim) via setupStartFunding(). setupStep/setupError/
    // setupBalance/setupClaims surface startLezFundingJob's progress so the
    // (real, PoW-bound) wait doesn't look frozen.
    PROP(bool setupRunning READWRITE)
    PROP(QString setupJobId READWRITE)
    PROP(QString setupStep READWRITE)
    PROP(QString setupError READWRITE)
    PROP(QString setupBalance READWRITE)
    PROP(QString setupTarget READWRITE)
    PROP(int setupClaims READWRITE)
    // Which Setup flow the page runs (issue #166). TRUE by default: the
    // faucet-less Setup, where step 3 only INITIALIZES the LEZ account (free,
    // one signed transaction) and LEZ is something you buy on the market. The
    // faucet is still reachable in the app, as its own section on the Setup
    // page — not through this flag. Resolved once at startup from the
    // environment (swap-ui/src/setup_flow.h); only the developer override
    // SWAP_UI_LEZ_FAUCET_MODE=on makes it false and restores the legacy
    // initialize-and-claim-150 step 3.
    PROP(bool setupFaucetless READWRITE)
    // True once this session has seen the LEZ account initialized on-chain,
    // by either path (setupInitializeAccount's outcome, or the funding job's
    // Initialized/AlreadyInitialized progress step). In-memory only: it is
    // reset when a different account is generated and NOT persisted, so a
    // relaunch shows the (fast, idempotent) activate step again rather than
    // guessing. A positive LEZ balance does NOT imply initialized — a credit
    // lands on a never-initialized account too — so it is never inferred;
    // guessing wrong costs a swap the sequencer silently drops. SetupView says
    // so on the card instead, since with the faucet-less flow now the default
    // a returning 0.4.5 user meets that step on their first relaunch.
    PROP(bool setupInitialized READWRITE)
    // In-house Sepolia drip faucet (PoC — see README-poc.md and eth-faucet/).
    // Resolved once at startup from swap-ui/src/eth_faucet_config.h
    // (SWAP_UI_ETH_FAUCET_URL, compiled default a local instance). EMPTY means
    // "no faucet is configured for this build": SetupView then shows only the
    // external-faucet copy-link path, exactly as 0.4.6 did. Not persisted and
    // not user-editable — a URL the app sends an address to and trusts to send
    // money back is a deployment decision, not a preference.
    PROP(QString ethFaucetUrl READWRITE)
    // The drip transaction, once one lands. Cleared at the start of every
    // request so a retry can never show the previous attempt's hash, and
    // cleared on a failure for the same reason.
    PROP(QString setupFaucetTxHash READWRITE)
    // What the faucet actually sent, decimal ETH, as IT reported it — the
    // service owns the drip size and can change it without an app release, so
    // the card must never state a figure of its own.
    PROP(QString setupFaucetAmountEth READWRITE)
    // The chain the drip landed on, as the FAUCET reported it — so the card's
    // explorer link is derived from an on-chain fact rather than from a config
    // field, the same rule SwapLinks/Links.qml applies to receipts. 0 until a
    // drip lands, which resolves to no link rather than a wrong-network one.
    PROP(int setupFaucetChainId READWRITE)

    SLOT(void setRole(const QString& role))
    SLOT(void setConfigValue(const QString& key, const QString& value))
    SLOT(void loadConfig(const QString& configJson))
    SLOT(void loadEnvFile(const QString& path, const QString& role))
    SLOT(bool validateConfig())

    SLOT(void fetchBalances())
    SLOT(void startMaker(const QString& hashlockHex))
    SLOT(void startTaker(const QString& preimageHex))
    SLOT(void acceptOfferAndStartTaker(const QString& offerJson))
    SLOT(void refundLez(const QString& hashlockHex))
    SLOT(void refundEth(const QString& swapIdHex))

    SLOT(void initMessaging())
    SLOT(void publishOffer())
    SLOT(void fetchOffers())
    // RFQ: taker publishes an anonymous offer-request so live makers respond
    // immediately (feat/rfq-on-demand-offers). Fired by OfferBoard on Market
    // activation and re-fired periodically while the tab is open.
    SLOT(void publishOfferRequest())
    SLOT(void startAutoAccept())
    SLOT(void stopAutoAccept())

    // Swap-history journal controls
    SLOT(void refreshHistory())
    SLOT(void clearHistory())

    // Config persistence (feat/persist-config). Deletes the on-disk
    // config.json and resets every live field back to the plugin's built-in
    // defaults — the escape hatch for a profile whose config.json holds
    // stale/bad credentials (it holds two private keys).
    SLOT(void resetConfig())

    // Guided first-run Setup (see SetupView.qml). Generation is instant/
    // local (no network) and writes straight into the existing
    // eth*/lez* config PROPs above (through the same persisted-config save
    // path as manual entry), so the rest of the app can't tell a generated
    // key from a pasted one. setupStartFunding runs initialize+fund as a
    // background job — see startLezFundingJob's ordering guarantee in
    // swap-module/src/swap_impl.h.
    SLOT(void setupGenerateEthKey())
    SLOT(void setupGenerateLezAccount())
    SLOT(void setupStartFunding())
    // Faucet-less step 3 (setupFaucetless): initialize the LEZ account on
    // its own — SwapImpl::lezEnsureInitialized, no pinata claim — as a
    // background call reported through the same setupRunning/setupStep/
    // setupError PROPs. Idempotent: an already-initialized account reports
    // AlreadyInitialized without a transaction.
    SLOT(void setupInitializeAccount())
    // Step 4's "Get test ETH" button: ask the in-house drip faucet for Sepolia
    // gas (fetch a proof-of-work challenge, solve it, claim). Reported through
    // the same setupRunning/setupStep/setupError PROPs as the other setup
    // jobs; SetupView's `setupOrigin` keeps its progress and errors inside
    // step 4's card rather than step 3's (the lesson of #173).
    SLOT(void setupRequestTestEth())
}

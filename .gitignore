# Build artifacts
target/
build/
build-*/

# Environment (generated by `make infra`)
.env
.env.taker
deploy/.env

# Maker crash-recovery journal (src/cli/maker.rs MAKER_STATE_FILE) and any
# status file the bot writes — CWD-relative by default, so a repo checkout
# used as the maker's working directory (the exact thing the container image
# now avoids, see deploy/README.md) would otherwise get a live journal
# tracked as source. Never actually ignored before this line (issue found
# while packaging the maker container).
.maker-state.json
*.maker-state.json
*.status.json

# Scaffold: wallet, circuits (Makefile), LEZ cache (see scaffold.toml) — all under .scaffold/
.scaffold/

# Claude Code
.claude
CLAUDE.md

